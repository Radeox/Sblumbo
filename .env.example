# ================= OBSIDIAN VAULT =================
VAULT_PATH=~/Obsidian

# Paths relative to VAULT_PATH (or absolute)
TODO_FILE=Tasks.md
NOTES_DIR=Notes
IDEAS_DIR=Ideas
LINKS_DIR=Links
DAILY_DIR=Daily

# ================= OLLAMA CONFIG ==================
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=300
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=512
OLLAMA_THINK=false

# ================= SCRAPER & GIT ==================
URL_FETCH_TIMEOUT=6
GIT_AUTO_COMMIT=true

# ================= TELEGRAM BOT ===================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
